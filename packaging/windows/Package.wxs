<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="RGV"
      Manufacturer="RGV Project"
      Version="$(var.RgvVersion)"
      UpgradeCode="D1861952-B4C5-4E1A-B5A4-64D8031F64EE"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of RGV is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- The icon of the Start menu shortcut and of RGV's entry in Installed apps. -->
    <Icon Id="RgvIcon" SourceFile="$(sys.SOURCEFILEDIR)..\icons\rgv.ico" />
    <Property Id="ARPPRODUCTICON" Value="RgvIcon" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RGV">
        <Component Id="RgvExecutable" Guid="B483E788-81B0-46B8-A775-D40703DDA44C">
          <File Id="RgvDesktop" Source="$(var.RgvBinary)" Name="rgv-desktop.exe" KeyPath="yes" />
        </Component>
        <Component Id="RgvMcpExecutable" Guid="79746E42-E263-46E7-B81A-380D48FAAF4C">
          <File Id="RgvMcp" Source="$(var.RgvMcpBinary)" Name="rgv-mcp.exe" KeyPath="yes" />
        </Component>
        <Directory Id="LICENSEFOLDER" Name="licenses">
          <Component Id="RgvReleaseMetadata" Guid="A9C3A7CA-3F4B-4AE9-A8E6-9622991DF4C5">
            <File Source="$(var.RgvResources)\LICENSE-MIT" />
            <File Source="$(var.RgvResources)\LICENSE-APACHE" />
            <File Source="$(var.RgvResources)\THIRD_PARTY_LICENSES.txt" />
            <File Source="$(var.RgvResources)\RGV.cdx.json" />
            <File Source="$(var.RgvResources)\BUILD-PROVENANCE.json" />
            <File Source="$(var.RgvPackageRoot)\PACKAGE-MANIFEST.sha256" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <!-- Windows Installer requires a shortcut's key path to be a per-user (HKCU) value, even in
           a per-machine package (ICE38, ICE43, ICE57). -->
      <Component Id="RgvStartMenuShortcut" Guid="5E0C8F3A-6B2D-4C61-9F7E-2A4D1B8C3E95">
        <Shortcut
            Id="RgvStartMenu"
            Name="RGV"
            Description="Rust Genome Viewer"
            Icon="RgvIcon"
            Target="[INSTALLFOLDER]rgv-desktop.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\RGV"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="RGV" Level="1">
      <ComponentRef Id="RgvExecutable" />
      <ComponentRef Id="RgvMcpExecutable" />
      <ComponentRef Id="RgvReleaseMetadata" />
      <ComponentRef Id="RgvStartMenuShortcut" />
      <!-- The built-in gene landmarks, beside the executable where RGV looks for them. -->
      <Files Directory="INSTALLFOLDER" Subdirectory="landmarks" Include="$(var.RgvPackageRoot)\landmarks\**" />
    </Feature>
  </Package>
</Wix>
