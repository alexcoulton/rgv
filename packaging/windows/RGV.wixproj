<Project Sdk="WixToolset.Sdk/6.0.0">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>RGV-windows-x86_64</OutputName>
    <OutputType>Package</OutputType>
    <DefineConstants>RgvBinary=$(RgvBinary);RgvMcpBinary=$(RgvMcpBinary);RgvPackageRoot=$(RgvPackageRoot);RgvResources=$(RgvResources);RgvVersion=$(RgvVersion)</DefineConstants>
  </PropertyGroup>
</Project>
