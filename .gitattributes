# Check text out with LF line endings on every platform. Tests read source files and fixtures
# byte for byte (include_str!, golden outputs), and a Windows checkout would otherwise turn
# them into CRLF.
* text=auto eol=lf

*.png binary
*.icns binary
*.ico binary
*.bam binary
*.bai binary
*.cram binary
*.crai binary
*.gz binary
*.tbi binary
*.csi binary
*.bw binary
*.bb binary
*.tdf binary
